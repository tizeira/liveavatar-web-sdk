// Minimal durable model for Clara consultations.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum ClaraConsultationStatus {
  pending
  routine_ready
  processing
  completed
  failed
}

model ClaraConsultation {
  id String @id @db.Uuid

  // Browser recap access is capability-based. Only the SHA-256 hash is stored.
  accessTokenHash String

  // Stable, non-enumerable HMAC derived from Shopify customer_id. The raw
  // customer ID, email, name, signed URL and Shopify token are never persisted.
  shopifyCustomerKey String?

  liveAvatarSessionId      String?                 @unique
  elevenLabsConversationId String?                 @unique
  status                   ClaraConsultationStatus @default(pending)

  // Transcript is normalized and short-lived. Summary and routine live for
  // the consultation retention period. Provider analysis is allowlisted.
  transcript      Json?
  analysisMetrics Json?
  summary         String?
  routine         Json?

  // The voice agent may only propose a Shopify-validated routine. The buyer
  // must resolve that proposal from the authenticated web UI before it can
  // replace the durable routine above.
  routineProposal           Json?
  routineProposalSummary    String?
  routineProposedAt         DateTime?
  routineProposalResolvedAt DateTime?
  routineConfirmedAt        DateTime?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  completedAt             DateTime?
  transcriptExpiresAt     DateTime
  recordExpiresAt         DateTime
  metricsRecordedAt       DateTime?
  routineMetricRecordedAt DateTime?

  @@index([shopifyCustomerKey, completedAt])
  @@index([status])
  @@index([transcriptExpiresAt])
  @@index([recordExpiresAt])
  @@map("clara_consultations")
}

model ClaraDailyMetric {
  date DateTime @id @db.Date

  consultationsCompleted   Int @default(0)
  consultationsWithRoutine Int @default(0)
  consultationsFailed      Int @default(0)
  transcriptsPurged        Int @default(0)
  recordsPurged            Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("clara_daily_metrics")
}

model ClaraCatalogProduct {
  // Shopify's ID remains stable if the merchant changes the public handle.
  shopifyProductId String @id
  handle           String @unique
  title            String

  // Canonical product payload returned by the Clara tool. Search-only text is
  // stored separately so internal tags/product type do not leak to the agent.
  payload    Json
  searchText String @db.Text

  availableForSale Boolean
  shopifyUpdatedAt DateTime
  syncedAt         DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([availableForSale])
  @@index([shopifyUpdatedAt])
  @@map("clara_catalog_products")
}

model ClaraCatalogState {
  source String @id

  productCount         Int
  catalogFingerprint   String
  lastShopifyUpdatedAt DateTime?
  lastSuccessfulSyncAt DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("clara_catalog_state")
}
