# NextAuth Configuration
# Generate with: openssl rand -base64 32
# CRITICAL: Required for secure JWT tokens
AUTH_SECRET=your_auth_secret_generate_with_openssl

# HeyGen Configuration
HEYGEN_API_KEY=your_heygen_api_key

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# OpenAI Configuration (optional)
OPENAI_API_KEY=your_openai_api_key

# Database (Neon Postgres)
# Las inyecta automaticamente la integracion Neon <-> Vercel. Para desarrollo
# local, traelas con `vercel env pull` o copialas desde la consola de Neon.
#
# POOLED (host con sufijo -pooler): la usa la app en runtime. Va en `url` del
# datasource. Soporta miles de conexiones concurrentes, necesario en serverless.
POSTGRES_PRISMA_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# DIRECTA (mismo host SIN -pooler): la usa el CLI de Prisma para migraciones y
# DDL. Va en `directUrl`. PgBouncer en transaction mode no soporta migraciones de
# esquema, por eso hace falta esta aparte.
POSTGRES_URL_NON_POOLING=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Maintenance Mode
# Set to "true" to block demo access and show maintenance page
MAINTENANCE_MODE=false
