# NextAuth Configuration
# Generate with: openssl rand -base64 32
# CRITICAL: Required for secure JWT tokens
AUTH_SECRET=your_auth_secret_generate_with_openssl

# HeyGen Configuration
HEYGEN_API_KEY=your_heygen_api_key

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
# Generated when the workspace post-call webhook is created.
ELEVENLABS_WEBHOOK_SECRET=your_elevenlabs_webhook_secret
# Separate bearer token used only by Clara's ElevenLabs webhook tools.
CLARA_AGENT_TOOL_SECRET=generate_a_random_32_byte_secret
# Vercel sends this as Authorization: Bearer <CRON_SECRET> to maintenance jobs.
CRON_SECRET=generate_a_separate_random_32_byte_secret

# Neon: pooled for application traffic, direct for Prisma migrations.
POSTGRES_PRISMA_URL=postgresql://user:password@host-pooler/db?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@host/db?sslmode=require

# OpenAI Configuration (optional)
OPENAI_API_KEY=your_openai_api_key

# Maintenance Mode
# Set to "true" to block demo access and show maintenance page
MAINTENANCE_MODE=false
