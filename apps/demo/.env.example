# HeyGen Configuration
HEYGEN_API_KEY=your_heygen_api_key

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# OpenAI Configuration (required for voice agent)
OPENAI_API_KEY=your_openai_api_key

# OpenAI Realtime Voice Agent Configuration (optional)
# Model: gpt-4o-realtime-preview (better quality) or gpt-4o-mini-realtime-preview (lower cost)
OPENAI_REALTIME_MODEL=gpt-4o-mini-realtime-preview
# Voice: alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_REALTIME_VOICE=alloy
# System instructions for the voice agent (optional)
# OPENAI_REALTIME_INSTRUCTIONS=Your custom instructions here
