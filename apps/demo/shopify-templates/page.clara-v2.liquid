{% comment %}
  Clara QA access v2. The signature covers purchase entitlement and expires in
  five minutes. Clara exchanges it for an HttpOnly ticket and cleans the URL.

  This page redirects the browser to Clara at the top level. Do not embed the
  target in an iframe: the access exchange needs to set Clara's first-party
  HttpOnly cookie before it removes the signed parameters from the URL.
{% endcomment %}

{%- liquid
  assign clara_domain = 'https://testers.betaskintech.com'
  assign hmac_secret = shop.metafields.custom.hmac_secret
  assign widget_url = clara_domain

  if customer and hmac_secret != blank
    assign customer_id = customer.id
    assign orders_count = customer.orders_count
    assign issued_at = 'now' | date: '%s'
    assign last_order_product = blank
    assign last_order_date = blank

    if customer.last_order
      assign last_order_line_item = customer.last_order.line_items | first
      assign last_order_product = last_order_line_item.title
      assign last_order_date = customer.last_order.created_at | date: '%Y-%m-%dT%H:%M:%SZ'
    endif

    assign signed_payload = 'v=2&customer_id=' | append: customer_id | append: '&orders_count=' | append: orders_count | append: '&issued_at=' | append: issued_at | append: '&purchase_context=1&last_order_date=' | append: last_order_date | append: '&last_order_product=' | append: last_order_product
    assign shopify_token = signed_payload | hmac_sha256: hmac_secret
    assign encoded_first_name = customer.first_name | url_encode
    assign encoded_last_order_product = last_order_product | url_encode
    assign encoded_last_order_date = last_order_date | url_encode

    assign widget_url = clara_domain
    assign widget_url = widget_url | append: '?clara_v=2&customer_id=' | append: customer_id
    assign widget_url = widget_url | append: '&orders_count=' | append: orders_count
    assign widget_url = widget_url | append: '&issued_at=' | append: issued_at
    assign widget_url = widget_url | append: '&purchase_context=1'
    assign widget_url = widget_url | append: '&last_order_date=' | append: encoded_last_order_date
    assign widget_url = widget_url | append: '&last_order_product=' | append: encoded_last_order_product
    assign widget_url = widget_url | append: '&shopify_token=' | append: shopify_token

    if customer.first_name != blank
      assign widget_url = widget_url | append: '&first_name=' | append: encoded_first_name
    endif
  endif
-%}

<script>
  window.location.replace({{ widget_url | json }});
</script>

<noscript>
  <p><a href="{{ widget_url | escape }}">Continuar a Clara</a></p>
</noscript>
